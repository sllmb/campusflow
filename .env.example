# Copier ce fichier en .env.local et remplir les valeurs (Supabase > Project Settings > API).
# .env.local est ignoré par git : ne jamais y committer de secrets.

NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=votre-cle-publique

# --- Rappels du matin (facultatif en local) ---
# Clé secrète Supabase (Project Settings > API Keys > Secret keys). Elle contourne la RLS :
# JAMAIS côté client, JAMAIS sur GitHub. Utilisée seulement par src/app/api/rappels.
SUPABASE_SECRET_KEY=
# Clé privée VAPID (la clé publique est dans src/features/reminders/config.ts).
VAPID_PRIVATE_KEY=
# Mot de passe que Vercel Cron envoie au rappel du matin (une longue chaîne aléatoire).
CRON_SECRET=
